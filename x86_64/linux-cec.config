# HDMI-CEC on the vc4 KMS HDMI encoder: creates /dev/cecN (one per HDMI
# port) so cec-ctl can wake / select-input / volume-step an attached AV
# receiver or TV. Selects CEC_CORE (built as a module alongside vc4, which
# modprobe pulls in as a dependency). Already =y in the upstream rpi3/rpi4/
# rpi5 defconfigs (Pi 5's HDMI is vc4 too: brcm,bcm2712-hdmi0/1); this
# fragment makes it explicit everywhere it's referenced and turns it on for
# rpi0_2 (Zero 2 W / 3A+), whose upstream defconfig leaves it off. The driver
# only binds when config.txt loads dtoverlay=vc4-kms-v3d (firmware display
# path = no /dev/cecN).
CONFIG_DRM_VC4_HDMI_CEC=y
